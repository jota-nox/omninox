<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>OmniNox</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <pkg-ref id="com.omninox.installer"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.omninox.installer"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.omninox.installer" visible="false">
        <pkg-ref id="com.omninox.installer"/>
    </choice>
    <pkg-ref id="com.omninox.installer" version="1.0.0" onConclusion="none">omninox.pkg</pkg-ref>
</installer-gui-script>
