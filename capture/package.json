{
  "name": "omninox-capture",
  "version": "1.0.0",
  "description": "Quick capture for OmniNox — Obsidian inbox",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac"
  },
  "build": {
    "appId": "com.omninox.capture",
    "productName": "OmniNox Capture",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  }
}
